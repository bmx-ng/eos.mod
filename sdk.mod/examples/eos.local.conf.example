# Copy this file to eos.local.conf and fill in values from the EOS Developer Portal.
# eos.local.conf is ignored by Git.

PRODUCT_ID=
SANDBOX_ID=
DEPLOYMENT_ID=
CLIENT_ID=
CLIENT_SECRET=
# A stable 256-bit key written as exactly 64 hexadecimal characters. Storage
# files cannot be recovered if this key is changed or lost.
ENCRYPTION_KEY=
# Storage requires an absolute cache path. The storage example uses its own
# executable directory when this is empty.
CACHE_DIRECTORY=

# Values configured in the EOS Developer Authentication Tool.
DEV_AUTH_HOST=localhost:6547
DEV_AUTH_CREDENTIAL=
# Optional second credential used by the two-account P2P and Sessions test apps.
DEV_AUTH_CREDENTIAL_2=

# Set to 1 only when this test should create a Product User for a new login.
CREATE_MISSING_PRODUCT_USER=0

# The Stats example requires a stat already configured in the Developer Portal.
STAT_NAME=
STAT_INGEST_AMOUNT=1

# Optional explicit-unlock test. Keep disabled unless this mutation is intended.
ACHIEVEMENT_ID=
UNLOCK_ACHIEVEMENT=0

# Optional file already uploaded to Title Storage. The storage stream example
# skips its Title Storage read when this is empty.
TITLE_STORAGE_FILENAME=
